DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=repo.example.internal
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_INITIAL_ADMIN_USERNAME=admin
DJANGO_INITIAL_ADMIN_PASSWORD=change-me
DJANGO_INITIAL_ADMIN_EMAIL=admin@example.com

POSTGRES_DB=artifact_repo
POSTGRES_USER=artifact_repo
POSTGRES_PASSWORD=artifact_repo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ARTIFACT_STORAGE_ROOT=/srv/artifact-repo/storage
MAX_ARTIFACT_SIZE=2147483648
